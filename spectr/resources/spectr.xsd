<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spectr HTML document schema: a restricted subset of HTML (same local names as HTML/XHTML)
  aligned with specs/change_set_name/spec_sample.html.

  W3C XML Schema 1.0 cannot branch a single <div> on @type for different content models, and
  libxml2 additionally fails to validate an xs:choice of multiple <div> branches (same QName).
  This schema uses one recursive div type and shared paragraph attributes; semantic layout and
  body block order are enforced by spectr.struct_validate on load (see spectr.spec_ops._BODY_BLOCK_ORDER).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      Root: html → head (title) → body (@sid).

      Entity @sid values are stable once assigned (Spectr does not rewrite existing sids on load).
      New sids use a prefix (spec, uc, ac, tst, q, ph, tsk, fb) + hyphen + 8 lowercase hex digits
      (first UUID segment). Blank/missing @sid on known entities is filled when the spec is loaded.

      Intended body div order (enforced on load, not by XSD alone):
      use-case* → acceptance-criteria* → tests* → questions* → feedback* → plan*

      use-case div (intended): h3, narrative p(s), optional nested acceptance-criteria and/or
      questions divs. acceptance-criteria div (intended): p* (type=acceptance-criteria), optional
      questions div at end.

      Allowed elements: html, head, title, body, h1, h3, p, div, ol, li, img, ul.
      Inside p: optional text mixed with img, ul, or ol (plan-phase ol under div remains separate).
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="SpectrId">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IsoDateTime">
    <xs:restriction base="xs:dateTime"/>
  </xs:simpleType>

  <xs:simpleType name="IsoDateTimeOrEmpty">
    <xs:union memberTypes="IsoDateTime">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="0"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:simpleType name="DivTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="use-case"/>
      <xs:enumeration value="acceptance-criteria"/>
      <xs:enumeration value="tests"/>
      <xs:enumeration value="questions"/>
      <xs:enumeration value="feedback"/>
      <xs:enumeration value="plan"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ParagraphKindEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="desc"/>
      <xs:enumeration value="acceptance-criteria"/>
      <xs:enumeration value="question"/>
      <xs:enumeration value="answer"/>
      <xs:enumeration value="feedback"/>
      <xs:enumeration value="test"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OlKindEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="phase"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LiKindEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="task"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TitleType" mixed="true">
    <xs:sequence/>
  </xs:complexType>

  <xs:complexType name="H1Type" mixed="true">
    <xs:sequence/>
    <xs:attribute name="id" type="SpectrId" use="required"/>
  </xs:complexType>

  <xs:complexType name="H3Type" mixed="true">
    <xs:sequence/>
    <xs:attribute name="id" type="SpectrId" use="required"/>
  </xs:complexType>

  <xs:complexType name="ImgType">
    <xs:attribute name="src" type="xs:anyURI" use="required"/>
    <xs:attribute name="alt" type="xs:string" use="optional"/>
    <xs:attribute name="width" type="xs:string" use="optional"/>
    <xs:attribute name="height" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="LiInlineType" mixed="true">
    <xs:sequence/>
  </xs:complexType>

  <xs:complexType name="UlInlineType">
    <xs:sequence>
      <xs:element name="li" type="LiInlineType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OlInlineType">
    <xs:sequence>
      <xs:element name="li" type="LiInlineType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PMixedContent" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="img" type="ImgType"/>
      <xs:element name="ul" type="UlInlineType"/>
      <xs:element name="ol" type="OlInlineType"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="PDescType">
    <xs:complexContent mixed="true">
      <xs:extension base="PMixedContent">
        <xs:attribute name="type" type="ParagraphKindEnum" use="required" fixed="desc"/>
        <xs:attribute name="id" type="SpectrId" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="SpectrPType">
    <xs:complexContent mixed="true">
      <xs:extension base="PMixedContent">
        <xs:attribute name="id" type="SpectrId" use="required"/>
        <xs:attribute name="type" type="ParagraphKindEnum" use="optional"/>
        <xs:attribute name="author" type="xs:string" use="optional"/>
        <xs:attribute name="target" type="xs:string" use="optional"/>
        <xs:attribute name="sid" type="SpectrId" use="optional"/>
        <xs:attribute name="ref_id" type="SpectrId" use="optional"/>
        <xs:attribute name="ts" type="IsoDateTimeOrEmpty" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="LiTaskType" mixed="true">
    <xs:sequence/>
    <xs:attribute name="type" type="LiKindEnum" use="required" fixed="task"/>
    <xs:attribute name="id" type="SpectrId" use="required"/>
    <xs:attribute name="sid" type="SpectrId" use="optional"/>
  </xs:complexType>

  <xs:complexType name="OlPhaseType">
    <xs:sequence>
      <xs:element name="li" type="LiTaskType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="OlKindEnum" use="required" fixed="phase"/>
    <xs:attribute name="sid" type="SpectrId" use="optional"/>
  </xs:complexType>

  <xs:complexType name="SpectrDivType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="h3" type="H3Type"/>
      <xs:element name="p" type="SpectrPType"/>
      <xs:element name="div" type="SpectrDivType"/>
      <xs:element name="ol" type="OlPhaseType"/>
    </xs:choice>
    <xs:attribute name="type" type="DivTypeEnum" use="required"/>
    <xs:attribute name="sid" type="SpectrId" use="optional"/>
    <xs:attribute name="ts" type="IsoDateTimeOrEmpty" use="optional"/>
  </xs:complexType>

  <xs:complexType name="HeadType">
    <xs:sequence>
      <xs:element name="title" type="TitleType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BodyType">
    <xs:sequence>
      <xs:element name="h1" type="H1Type"/>
      <xs:element name="p" type="PDescType"/>
      <xs:element name="div" type="SpectrDivType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="sid" type="SpectrId" use="required"/>
  </xs:complexType>

  <xs:complexType name="HtmlType">
    <xs:sequence>
      <xs:element name="head" type="HeadType"/>
      <xs:element name="body" type="BodyType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="html" type="HtmlType"/>

</xs:schema>
